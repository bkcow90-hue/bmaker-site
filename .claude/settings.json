{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git checkout -- .*)",
      "Bash(git checkout .*)",
      "Bash(git restore .*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git rebase --skip*)"
    ]
  }
}
